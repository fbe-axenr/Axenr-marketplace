      "default": [2, "never", ["sentence-case", "start-case", "pascal-case", "upper-case"]],
      "example": [2, "never", ["sentence-case", "start-case", "pascal-case", "upper-case"]]
    },
    "subject-empty": {
      "description": "Enforce subject presence or absence",
      "type": "empty",
