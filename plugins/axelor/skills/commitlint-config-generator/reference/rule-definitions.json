{
  "rules": {
    "body-case": {
      "description": "Enforce case for body",
      "type": "case",
      "applicable": ["always", "never"],
      "values": ["lower-case", "upper-case", "sentence-case", "start-case", "pascal-case"],
      "default": [0],
      "example": [2, "always", "lower-case"]
    },
    "body-empty": {
      "description": "Enforce body presence or absence",
      "type": "empty",
      "applicable": ["always", "never"],
      "default": [0],
      "example": [2, "never"]
    },
    "body-full-stop": {
      "description": "Enforce full stop at end of body",
      "type": "full-stop",
      "applicable": ["always", "never"],
      "values": [".", "!", "?"],
      "default": [0],
      "example": [2, "never", "."]
    },
    "body-leading-blank": {
      "description": "Enforce blank line before body",
      "type": "leading-blank",
      "applicable": ["always", "never"],
      "default": [1, "always"],
      "example": [1, "always"]
    },
    "body-max-length": {
      "description": "Enforce maximum body length",
      "type": "max-length",
      "applicable": ["always"],
      "values": "number",
      "default": [0],
      "example": [2, "always", 500]
    },
    "body-max-line-length": {
      "description": "Enforce maximum line length in body",
      "type": "max-line-length",
      "applicable": ["always"],
      "values": "number",
      "default": [2, "always", 100],
      "example": [2, "always", 100]
    },
    "body-min-length": {
      "description": "Enforce minimum body length",
      "type": "min-length",
      "applicable": ["always"],
      "values": "number",
      "default": [0],
      "example": [2, "always", 20]
    },
    "footer-empty": {
      "description": "Enforce footer presence or absence",
      "type": "empty",
      "applicable": ["always", "never"],
      "default": [0],
      "example": [2, "never"]
    },
    "footer-leading-blank": {
      "description": "Enforce blank line before footer",
      "type": "leading-blank",
      "applicable": ["always", "never"],
      "default": [1, "always"],
      "example": [1, "always"]
    },
    "footer-max-length": {
      "description": "Enforce maximum footer length",
      "type": "max-length",
      "applicable": ["always"],
      "values": "number",
      "default": [0],
      "example": [2, "always", 500]
    },
    "footer-max-line-length": {
      "description": "Enforce maximum line length in footer",
      "type": "max-line-length",
      "applicable": ["always"],
      "values": "number",
      "default": [2, "always", 100],
      "example": [2, "always", 100]
    },
    "footer-min-length": {
      "description": "Enforce minimum footer length",
      "type": "min-length",
      "applicable": ["always"],
      "values": "number",
      "default": [0],
      "example": [2, "always", 20]
    },
    "header-case": {
      "description": "Enforce case for header",
      "type": "case",
      "applicable": ["always", "never"],
      "values": ["lower-case", "upper-case", "sentence-case", "start-case", "pascal-case"],
      "default": [0],
      "example": [2, "always", "lower-case"]
    },
    "header-full-stop": {
      "description": "Enforce full stop at end of header",
      "type": "full-stop",
      "applicable": ["always", "never"],
      "values": [".", "!", "?"],
      "default": [0],
      "example": [2, "never", "."]
    },
    "header-max-length": {
      "description": "Enforce maximum header length",
      "type": "max-length",
      "applicable": ["always"],
      "values": "number",
      "default": [2, "always", 100],
      "example": [2, "always", 100]
    },
    "header-min-length": {
      "description": "Enforce minimum header length",
      "type": "min-length",
      "applicable": ["always"],
      "values": "number",
      "default": [0],
      "example": [2, "always", 10]
