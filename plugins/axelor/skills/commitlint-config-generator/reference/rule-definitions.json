      "description": "Enforce full stop at end of subject",
      "type": "full-stop",
      "applicable": ["always", "never"],
      "values": [".", "!", "?"],
      "default": [2, "never", "."],
      "example": [2, "never", "."]
    },
    "subject-max-length": {
      "description": "Enforce maximum subject length",
      "type": "max-length",
      "applicable": ["always"],
      "values": "number",
      "default": [0],
      "example": [2, "always", 72]
    },
    "subject-min-length": {
      "description": "Enforce minimum subject length",
      "type": "min-length",
      "applicable": ["always"],
      "values": "number",
      "default": [0],
      "example": [2, "always", 10]
    },
    "type-case": {
      "description": "Enforce case for type",
      "type": "case",
      "applicable": ["always", "never"],
      "values": ["lower-case", "upper-case", "sentence-case", "start-case", "pascal-case", "kebab-case", "camel-case", "snake-case"],
      "default": [2, "always", "lower-case"],
      "example": [2, "always", "lower-case"]
    },
    "type-empty": {
      "description": "Enforce type presence or absence",
      "type": "empty",
      "applicable": ["always", "never"],
      "default": [2, "never"],
      "example": [2, "never"]
    },
    "type-enum": {
      "description": "Enforce type to be from enum",
      "type": "enum",
      "applicable": ["always", "never"],
      "values": "array",
      "default": [2, "always", ["feat", "fix", "docs", "style", "refactor", "perf", "test", "build", "ci", "chore", "revert"]],
      "example": [2, "always", ["feat", "fix", "docs", "style", "refactor", "perf", "test", "build", "ci", "chore", "revert"]]
    },
    "type-max-length": {
      "description": "Enforce maximum type length",
      "type": "max-length",
      "applicable": ["always"],
      "values": "number",
      "default": [0],
      "example": [2, "always", 10]
    },
    "type-min-length": {
      "description": "Enforce minimum type length",
      "type": "min-length",
      "applicable": ["always"],
      "values": "number",
      "default": [0],
      "example": [2, "always", 3]
    }
  },
  "severityLevels": {
    "0": "disabled",
    "1": "warning",
    "2": "error"
  },
  "applicableValues": {
    "always": "Rule must be applied",
    "never": "Rule must not be applied"
  },
  "caseTypes": {
    "lower-case": "all lowercase (feat)",
    "upper-case": "all uppercase (FEAT)",
    "sentence-case": "First letter uppercase (Feat)",
    "start-case": "Each word uppercase (Feat Module)",
    "pascal-case": "PascalCase (FeatModule)",
    "camel-case": "camelCase (featModule)",
    "kebab-case": "kebab-case (feat-module)",
    "snake-case": "snake_case (feat_module)"
  },
  "commonProfiles": {
    "strict": {
      "description": "Axelor standard profile with strict validation",
      "characteristics": [
        "Header max 100 chars (hard limit)",
        "Body max 100 chars per line",
        "Strict type enforcement",
        "No emojis, no Co-Authored-By",
        "Warnings for blank lines"
      ],
      "use_cases": [
        "Production repositories",
        "Team collaboration",
        "Automated changelog generation"
      ]
    },
    "standard": {
      "description": "Balanced profile for conventional commits",
      "characteristics": [
        "Header max 100 chars",
        "Body max 100 chars per line",
        "Standard type validation",
        "Optional scope"
      ],
      "use_cases": [
        "Standard projects",
        "Squash-only workflows",
        "Simple validation needs"
      ]
    },
    "relaxed": {
      "description": "Lenient profile for learning/transition",
      "characteristics": [
        "Header max 120 chars",
        "Body max 120 chars per line",
        "Warnings instead of errors",
        "Suitable for onboarding"
      ],
      "use_cases": [
        "Learning environments",
        "Transitioning teams",
        "Personal projects"
      ]
    }
  },
  "typeDescriptions": {
    "feat": "A new feature",
    "fix": "A bug fix",
    "docs": "Documentation only changes",
    "style": "Code style changes (formatting, white-space, etc.)",
    "refactor": "Code refactoring without changing functionality",
    "perf": "Performance improvements",
    "test": "Adding or updating tests",
    "build": "Build system or external dependency changes",
    "ci": "CI/CD configuration changes",
    "chore": "Other changes that don't modify src or test files",
    "revert": "Reverts a previous commit"
  },
  "exampleScopes": {
    "modules": ["auth", "sale", "purchase", "inventory", "production", "stock", "crm", "hr"],
    "features": ["api", "ui", "db", "cache", "security", "validation", "config"],
    "packages": ["core", "web", "mobile", "cli", "sdk"]
